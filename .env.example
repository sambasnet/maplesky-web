# MapleSky Travels Environment Variables

# Site URL (used for metadata and canonical URLs)
NEXT_PUBLIC_SITE_URL=https://mapleskytravels.com

# Google Site Verification (from Google Search Console)
# GOOGLE_SITE_VERIFICATION=your-verification-code

# Email Service Integration (Mailchimp, SendGrid, etc.)
# MAILCHIMP_API_KEY=your-mailchimp-api-key
# MAILCHIMP_AUDIENCE_ID=your-audience-id
# SENDGRID_API_KEY=your-sendgrid-api-key

# Database (for waitlist storage)
# DATABASE_URL=postgresql://user:password@localhost:5432/maplesky

# Chat Service (OpenAI, Anthropic, etc.)
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Analytics
# GOOGLE_ANALYTICS_ID=your-ga-id
# MIXPANEL_TOKEN=your-mixpanel-token

# Optional: Rate limiting
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=60000